SUM
NOPBC
... CONTACTMAP

lw1: LOWER_WALLS ARG=cmap1 AT=0.95 KAPPA=40000
lw2: LOWER_WALLS ARG=cmap3 AT=0.95 KAPPA=40000

mt: ECV_MULTITHERMAL ARG=ene TEMP=390 TEMP_MIN=300 TEMP_MAX=480
umb: ECV_UMBRELLAS_LINE ARG=cmap2_plus TEMP=390 CV_MIN=0 CV_MAX=1 SIGMA=0.05 BARRIER=200
umb2: ECV_UMBRELLAS_LINE ARG=cmap2_6_plus TEMP=390 CV_MIN=0 CV_MAX=1 SIGMA=0.05 BARRIER=200

opes: OPES_EXPANDED ARG=mt.*,umb.*,umb2.* PACE=500 FILE=../DELTAFS PRINT_STRIDE=500 WALKERS_MPI

PRINT STRIDE=500 ARG=* FILE=colvar
